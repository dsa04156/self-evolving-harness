{
  "name": "self-evolving-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone coding-agent runtime with a separately governed harness-evolution lifecycle.",
  "engines": {
    "node": "24.18.1"
  },
  "packageManager": "npm@11.18.0",
  "scripts": {
    "build": "npx -y node@24.18.1 ./node_modules/typescript/bin/tsc",
    "check": "npx -y node@24.18.1 ./node_modules/typescript/bin/tsc --noEmit",
    "test": "npx -y node@24.18.1 --import tsx --test test/**/*.test.ts",
    "test:coverage": "npx -y node@24.18.1 --import tsx --test --experimental-test-coverage test/**/*.test.ts",
    "create:hfb-governance-deviation": "npx -y node@24.18.1 --import tsx scripts/create-hfb-governance-deviation.ts",
    "create:hfb-remediation-closure": "npx -y node@24.18.1 --import tsx scripts/create-hfb-remediation-closure.ts --write",
    "verify:hfb-governance": "npx -y node@24.18.1 --import tsx scripts/verify-hfb-governance-quarantine.ts",
    "validate:hfb-structural-oracle": "npx -y node@24.18.1 --import tsx scripts/validate-hfb-structural-oracle.ts",
    "validate:hfb-semantic": "npx -y node@24.18.1 --import tsx scripts/validate-hfb-semantic.ts",
    "generate:hfb-semantic-evidence": "npx -y node@24.18.1 --import tsx scripts/validate-hfb-semantic.ts --write",
    "verify:hfb-semantic-evidence": "npx -y node@24.18.1 --import tsx scripts/verify-hfb-semantic-evidence.ts",
    "generate:development-attribution-dry-run": "npx -y node@24.18.1 --import tsx scripts/generate-development-attribution-dry-run.ts",
    "verify:development-attribution-dry-run": "npx -y node@24.18.1 --import tsx scripts/verify-development-attribution-dry-run.ts",
    "generate:development-process-boundary": "SEH_REQUIRE_DEVELOPMENT_OS_BOUNDARY=1 SEH_DEVELOPMENT_BOUNDARY_EVIDENCE_OUTPUT=architect/evidence/development-process-boundary/os-boundary.json npx -y node@24.18.1 --import tsx --test test/development-os-boundary.test.ts",
    "verify:development-process-boundary": "npx -y node@24.18.1 --import tsx scripts/verify-development-process-boundary.ts",
    "generate:evaluator-vault-os-boundary": "SEH_REQUIRE_EVALUATOR_VAULT_OS_BOUNDARY=1 SEH_EVALUATOR_VAULT_OS_EVIDENCE_OUTPUT=architect/evidence/evaluator-vault-os-boundary/evidence.json npx -y node@24.18.1 --import tsx --test test/evaluator-vault-os-boundary.test.ts",
    "verify:evaluator-vault-os-boundary": "npx -y node@24.18.1 --import tsx scripts/verify-evaluator-vault-os-boundary.ts",
    "generate:synthetic-custody-os-boundary": "SEH_REQUIRE_SYNTHETIC_CUSTODY_OS_BOUNDARY=1 SEH_SYNTHETIC_CUSTODY_OS_EVIDENCE_OUTPUT=architect/evidence/synthetic-custody-os-boundary/evidence.json npx -y node@24.18.1 --import tsx --test test/synthetic-custody-os-boundary.test.ts",
    "verify:synthetic-custody-os-boundary": "npx -y node@24.18.1 --import tsx scripts/verify-synthetic-custody-os-boundary.ts",
    "create:publication-governance": "npx -y node@24.18.1 --import tsx scripts/create-publication-governance.ts",
    "verify:publication-governance": "npx -y node@24.18.1 --import tsx scripts/verify-publication-governance.ts",
    "create:historical-publication-governance": "npx -y node@24.18.1 --import tsx scripts/create-historical-publication-governance.ts",
    "verify:historical-publication-governance": "npx -y node@24.18.1 --import tsx scripts/verify-historical-publication-governance.ts",
    "create:trust-plane-conformance": "npx -y node@24.18.1 --import tsx scripts/create-trust-plane-conformance.ts --write",
    "verify:trust-plane-conformance": "npx -y node@24.18.1 --import tsx scripts/verify-trust-plane-conformance.ts",
    "create:numeric-freeze-entry": "npx -y node@24.18.1 --import tsx scripts/create-research-protocol-numeric-freeze-entry.ts",
    "verify:numeric-freeze-entry": "npx -y node@24.18.1 --import tsx scripts/verify-research-protocol-numeric-freeze-entry.ts",
    "cli": "npx -y node@24.18.1 --import tsx src/cli.ts",
    "smoke:real": "npx -y node@24.18.1 --import tsx scripts/run-real-provider-smoke.ts"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "openai": "7.1.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "c8": "12.0.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  }
}
