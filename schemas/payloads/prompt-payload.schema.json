{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://self-evolving-harness.local/schemas/payloads/prompt-payload.schema.json",
  "title": "SEH Prompt Markdown Payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "language",
    "sections",
    "contextBindings"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "language": {
      "const": "seh.prompt-markdown.v1"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sectionId",
          "purpose",
          "content"
        ],
        "properties": {
          "sectionId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{1,63}$"
          },
          "purpose": {
            "type": "string",
            "enum": [
              "identity",
              "system_rules",
              "task_method",
              "tool_guidance",
              "completion",
              "recovery",
              "subagent_role"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          }
        }
      }
    },
    "contextBindings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "task_input",
          "tool_catalog",
          "selected_memory",
          "selected_skills",
          "session_summary",
          "verification_feedback"
        ]
      }
    }
  }
}
