{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://self-evolving-harness.local/schemas/payloads/policy-json-payload.schema.json",
  "title": "Protocol-Authored Policy JSON Payload v1",
  "description": "This envelope is allowed only for immutable or conditionally-disabled protocol-authored components. It is never candidate-controlled.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "language",
    "policyType",
    "policy"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "language": {
      "const": "seh.policy-json.v1"
    },
    "policyType": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]{2,63}$"
    },
    "policy": {
      "type": "object"
    }
  }
}
