{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://self-evolving-harness.local/schemas/payloads/memory-retrieval-policy-payload.schema.json",
  "title": "SEH Memory Retrieval Policy Payload v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "language",
    "readableNamespaces",
    "queryMode",
    "maxRecords",
    "maxTokens",
    "minimumScoreMicros",
    "tieBreak"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "language": {
      "const": "seh.memory-retrieval-policy.v1"
    },
    "readableNamespaces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "project_facts",
          "user_preferences",
          "accepted_lessons",
          "rejected_mutations",
          "session_summaries"
        ]
      }
    },
    "queryMode": {
      "type": "string",
      "enum": [
        "recency",
        "lexical",
        "fixed_hybrid"
      ]
    },
    "hybridLexicalWeightMicros": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "maxRecords": {
      "type": "integer",
      "minimum": 0,
      "maximum": 128
    },
    "maxTokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65536
    },
    "minimumScoreMicros": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "tieBreak": {
      "type": "string",
      "enum": [
        "record_id_ascending",
        "created_at_then_record_id"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "queryMode": {
            "const": "fixed_hybrid"
          }
        },
        "required": [
          "queryMode"
        ]
      },
      "then": {
        "required": [
          "hybridLexicalWeightMicros"
        ]
      },
      "else": {
        "not": {
          "required": [
            "hybridLexicalWeightMicros"
          ]
        }
      }
    }
  ]
}
