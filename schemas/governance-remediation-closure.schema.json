{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://self-evolving-harness.local/schemas/governance-remediation-closure.schema.json",
  "title": "Signed Governance Remediation Closure",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "closureId",
    "recordType",
    "governanceDomainId",
    "deviationId",
    "deviationRecordHash",
    "architectDecision",
    "replacementEvidence",
    "remediation",
    "claimBoundary",
    "closureSourceCommit",
    "closedAt",
    "recordedBy",
    "recordHash",
    "publicPrincipal",
    "attestation"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "closureId": {
      "$ref": "./common.schema.json#/$defs/entityId"
    },
    "recordType": {
      "const": "governance_remediation_closure"
    },
    "governanceDomainId": {
      "$ref": "./common.schema.json#/$defs/entityId"
    },
    "deviationId": {
      "$ref": "./common.schema.json#/$defs/entityId"
    },
    "deviationRecordHash": {
      "$ref": "./common.schema.json#/$defs/sha256"
    },
    "architectDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "responsePath",
        "responseSha256"
      ],
      "properties": {
        "decision": {
          "const": "APPROVE"
        },
        "responsePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "responseSha256": {
          "$ref": "./common.schema.json#/$defs/sha256"
        }
      }
    },
    "replacementEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semanticSuiteCommitment",
        "labelBlindCorpusCommitment",
        "semanticEvidenceSourceCommit",
        "evidencePath",
        "evidenceFileSha256"
      ],
      "properties": {
        "semanticSuiteCommitment": {
          "$ref": "./common.schema.json#/$defs/sha256"
        },
        "labelBlindCorpusCommitment": {
          "$ref": "./common.schema.json#/$defs/sha256"
        },
        "semanticEvidenceSourceCommit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "evidencePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "evidenceFileSha256": {
          "$ref": "./common.schema.json#/$defs/sha256"
        }
      }
    },
    "remediation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "originalRecordWasModified",
        "originalStatusObserved",
        "closureStatus",
        "completedActions",
        "outstandingActions"
      ],
      "properties": {
        "originalRecordWasModified": {
          "const": false
        },
        "originalStatusObserved": {
          "const": "in_progress"
        },
        "closureStatus": {
          "const": "closed_by_append_only_record"
        },
        "completedActions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "outstandingActions": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "claimBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semanticDevelopmentFixtureCorrectionClosed",
        "researchEvidenceAuthorized",
        "attributionPerformanceClaim",
        "selfEvolutionClaim",
        "oldArtifactsRemainQuarantined"
      ],
      "properties": {
        "semanticDevelopmentFixtureCorrectionClosed": {
          "const": true
        },
        "researchEvidenceAuthorized": {
          "const": false
        },
        "attributionPerformanceClaim": {
          "const": false
        },
        "selfEvolutionClaim": {
          "const": false
        },
        "oldArtifactsRemainQuarantined": {
          "const": true
        }
      }
    },
    "closureSourceCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "closedAt": {
      "$ref": "./common.schema.json#/$defs/timestamp"
    },
    "recordedBy": {
      "$ref": "./common.schema.json#/$defs/principalIdentity"
    },
    "recordHash": {
      "$ref": "./common.schema.json#/$defs/sha256"
    },
    "publicPrincipal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "keyId",
        "publicKeyPem"
      ],
      "properties": {
        "identity": {
          "$ref": "./common.schema.json#/$defs/principalIdentity"
        },
        "keyId": {
          "$ref": "./common.schema.json#/$defs/entityId"
        },
        "publicKeyPem": {
          "type": "string",
          "pattern": "^-----BEGIN PUBLIC KEY-----\\n[A-Za-z0-9+/=\\n]+-----END PUBLIC KEY-----\\n$",
          "maxLength": 1000
        }
      }
    },
    "attestation": {
      "$ref": "./common.schema.json#/$defs/attestation"
    }
  }
}
