{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://self-evolving-harness.local/schemas/promotion-decision.schema.json",
  "title": "Harness Qualification PromotionDecision",
  "description": "A promoter-authenticated approve/reject decision for one exact whole-harness manifest. It changes qualification only; channel deployment requires a separate DeploymentDecision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "promotionDecisionId",
    "protocolId",
    "epistemicClass",
    "action",
    "parentHarnessVersionId",
    "candidateHarnessVersionId",
    "evaluationResultIds",
    "promotionPolicyHash",
    "candidateCostGate",
    "reasonCodes",
    "criteria",
    "decidedBy",
    "decidedAt",
    "auditLink",
    "attestation"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "promotionDecisionId": {
      "$ref": "./common.schema.json#/$defs/entityId"
    },
    "protocolId": {
      "$ref": "./common.schema.json#/$defs/protocolId"
    },
    "epistemicClass": {
      "const": "control_decision"
    },
    "action": {
      "type": "string",
      "enum": [
        "approve",
        "reject"
      ]
    },
    "parentHarnessVersionId": {
      "oneOf": [
        {
          "$ref": "./common.schema.json#/$defs/harnessVersionId"
        },
        {
          "type": "null"
        }
      ]
    },
    "candidateHarnessVersionId": {
      "$ref": "./common.schema.json#/$defs/harnessVersionId"
    },
    "evaluationResultIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "./common.schema.json#/$defs/entityId"
      }
    },
    "promotionPolicyHash": {
      "$ref": "./common.schema.json#/$defs/sha256"
    },
    "candidateCostGate": {
      "oneOf": [
        {
          "$ref": "./candidate-cost-gate.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "reasonCodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{2,95}$"
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gateId",
          "passed",
          "sourceResultId",
          "sourceDatasetRole"
        ],
        "properties": {
          "gateId": {
            "$ref": "./common.schema.json#/$defs/entityId"
          },
          "passed": {
            "type": "boolean"
          },
          "sourceResultId": {
            "$ref": "./common.schema.json#/$defs/entityId"
          },
          "sourceDatasetRole": {
            "type": "string",
            "enum": [
              "mine",
              "gate",
              "deterministic"
            ]
          }
        }
      }
    },
    "decidedBy": {
      "$ref": "./common.schema.json#/$defs/principalIdentity"
    },
    "decidedAt": {
      "$ref": "./common.schema.json#/$defs/timestamp"
    },
    "auditLink": {
      "$ref": "./common.schema.json#/$defs/auditLink"
    },
    "attestation": {
      "$ref": "./common.schema.json#/$defs/attestation"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "approve"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "candidateCostGate": {
            "$ref": "./candidate-cost-gate.schema.json"
          }
        }
      }
    }
  ]
}
