{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://self-evolving-harness.local/schemas/benchmarks/hfb-semantic-suite-commitment.schema.json",
  "title": "HarnessFaultBench Semantic Development Suite Commitment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "specVersion",
    "evidenceClass",
    "datasetRole",
    "fixtureCount",
    "authorityBoundary",
    "entries",
    "commitmentHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "specVersion": {
      "const": "hfb-semantic-development-1.0.0"
    },
    "evidenceClass": {
      "const": "deterministic_semantic_development_validation"
    },
    "datasetRole": {
      "const": "mine"
    },
    "fixtureCount": {
      "const": 28
    },
    "authorityBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "oracleSeparatedFromExecution",
        "executionPackagesContainLabels",
        "proposerInputRequiresLabelBlindAdapter",
        "attributionPerformanceClaim",
        "selfEvolutionClaim"
      ],
      "properties": {
        "oracleSeparatedFromExecution": {
          "const": true
        },
        "executionPackagesContainLabels": {
          "const": false
        },
        "proposerInputRequiresLabelBlindAdapter": {
          "const": true
        },
        "attributionPerformanceClaim": {
          "const": false
        },
        "selfEvolutionClaim": {
          "const": false
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 28,
      "maxItems": 28,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fixtureId",
          "oracleHash",
          "executionPackageHash",
          "validationReportHash",
          "knownGoodEventChainHash",
          "faultyEventChainHash"
        ],
        "properties": {
          "fixtureId": {
            "type": "string",
            "pattern": "^hfb-v0-[a-z-]+-0[1-4]$"
          },
          "oracleHash": {
            "$ref": "../common.schema.json#/$defs/sha256"
          },
          "executionPackageHash": {
            "$ref": "../common.schema.json#/$defs/sha256"
          },
          "validationReportHash": {
            "$ref": "../common.schema.json#/$defs/sha256"
          },
          "knownGoodEventChainHash": {
            "$ref": "../common.schema.json#/$defs/sha256"
          },
          "faultyEventChainHash": {
            "$ref": "../common.schema.json#/$defs/sha256"
          }
        }
      }
    },
    "commitmentHash": {
      "$ref": "../common.schema.json#/$defs/sha256"
    }
  }
}
