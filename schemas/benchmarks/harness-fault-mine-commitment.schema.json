{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://self-evolving-harness.local/schemas/benchmarks/harness-fault-mine-commitment.schema.json",
  "title": "Superseded HarnessFaultBench D_mine Structural-Oracle Suite Commitment",
  "description": "Development-only commitment for the manifest-ID oracle prototype; it is prohibited from official research protocols.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "specVersion",
    "fixtureCount",
    "fixtures",
    "suiteHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "specVersion": {
      "const": "hfb-fixture-spec-1.0.1"
    },
    "fixtureCount": {
      "const": 28
    },
    "fixtures": {
      "type": "array",
      "minItems": 28,
      "maxItems": 28,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fixtureId",
          "fixtureContentHash",
          "knownGoodHarnessVersionId",
          "faultyHarnessVersionId",
          "causalReportHash"
        ],
        "properties": {
          "fixtureId": {
            "type": "string",
            "pattern": "^hfb-v0-[a-z0-9-]+-(0[1-4])$"
          },
          "fixtureContentHash": {
            "$ref": "../common.schema.json#/$defs/sha256"
          },
          "knownGoodHarnessVersionId": {
            "$ref": "../common.schema.json#/$defs/harnessVersionId"
          },
          "faultyHarnessVersionId": {
            "$ref": "../common.schema.json#/$defs/harnessVersionId"
          },
          "causalReportHash": {
            "$ref": "../common.schema.json#/$defs/sha256"
          }
        }
      }
    },
    "suiteHash": {
      "$ref": "../common.schema.json#/$defs/sha256"
    }
  }
}
