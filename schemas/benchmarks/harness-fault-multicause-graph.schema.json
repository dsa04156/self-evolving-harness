{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://self-evolving-harness.local/schemas/benchmarks/harness-fault-multicause-graph.schema.json",
  "title": "HarnessFaultBench Multi-Cause Graph Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "graphId",
    "protocolVersion",
    "combinedFamilies",
    "edgeCount",
    "overallDegreePerFamily",
    "difficultyStrata",
    "edges"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "graphId": {
      "const": "hfb-v0-multicause-graph-1.0.1"
    },
    "protocolVersion": {
      "const": "draft-1"
    },
    "combinedFamilies": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "edgeCount": {
      "const": 14
    },
    "overallDegreePerFamily": {
      "const": 4
    },
    "difficultyStrata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "medium",
        "high"
      ],
      "properties": {
        "medium": {
          "$ref": "#/$defs/stratum"
        },
        "high": {
          "$ref": "#/$defs/stratum"
        }
      }
    },
    "edges": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "caseId",
          "difficulty",
          "familyA",
          "componentTypeA",
          "mechanismA",
          "familyB",
          "componentTypeB",
          "mechanismB"
        ],
        "properties": {
          "caseId": {
            "type": "string",
            "pattern": "^hfb-v0-multicause-(0[1-9]|1[0-4])$"
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "medium",
              "high"
            ]
          },
          "familyA": {
            "type": "string"
          },
          "componentTypeA": {
            "type": "string"
          },
          "mechanismA": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]+$"
          },
          "familyB": {
            "type": "string"
          },
          "componentTypeB": {
            "type": "string"
          },
          "mechanismB": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]+$"
          }
        }
      }
    }
  },
  "$defs": {
    "stratum": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edgeCount",
        "degreePerFamily"
      ],
      "properties": {
        "edgeCount": {
          "const": 7
        },
        "degreePerFamily": {
          "const": 2
        }
      }
    }
  }
}
