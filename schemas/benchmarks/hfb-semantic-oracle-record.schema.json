{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://self-evolving-harness.local/schemas/benchmarks/hfb-semantic-oracle-record.schema.json",
  "title": "HarnessFaultBench Benchmark-Author Semantic Oracle Record",
  "description": "Benchmark-author/scorer authority only. This object must never cross the runtime or proposer boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "fixtureId",
    "mechanismCode",
    "targetComponentType",
    "targetComponentId",
    "knownGoodHarnessVersionId",
    "faultyHarnessVersionId",
    "patch",
    "oracleHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "fixtureId": {
      "type": "string",
      "pattern": "^hfb-v0-[a-z-]+-0[1-4]$"
    },
    "mechanismCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,95}$"
    },
    "targetComponentType": {
      "type": "string",
      "enum": [
        "SystemPrompt",
        "ContextPolicy",
        "MemoryRetrievalPolicy",
        "Skill",
        "WorkflowPolicy",
        "RoutingPolicy",
        "SubagentPrompt",
        "ToolDescription"
      ]
    },
    "targetComponentId": {
      "$ref": "../common.schema.json#/$defs/entityId"
    },
    "knownGoodHarnessVersionId": {
      "$ref": "../common.schema.json#/$defs/harnessVersionId"
    },
    "faultyHarnessVersionId": {
      "$ref": "../common.schema.json#/$defs/harnessVersionId"
    },
    "patch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "path"],
      "properties": {
        "op": {
          "type": "string",
          "enum": ["add", "remove", "replace", "move"]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "value": {}
      }
    },
    "oracleHash": {
      "$ref": "../common.schema.json#/$defs/sha256"
    }
  }
}
