{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://self-evolving-harness.local/schemas/benchmarks/hfb-semantic-validation-report.schema.json",
  "title": "HarnessFaultBench Semantic Development Validation Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "fixtureId",
    "knownGoodPassed",
    "faultyPassed",
    "exactlyOneHarnessComponentChanged",
    "immutableDiffCount",
    "behaviorDivergedBeforeVerification",
    "groundTruthRestorationPassed",
    "nonGroundTruthRestorationPassed",
    "goodReplayHashes",
    "faultyReplayHashes",
    "goodReplayHashesIdentical",
    "faultyReplayHashesIdentical",
    "reportHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "fixtureId": {
      "type": "string",
      "pattern": "^hfb-v0-[a-z-]+-0[1-4]$"
    },
    "knownGoodPassed": {
      "const": true
    },
    "faultyPassed": {
      "const": false
    },
    "exactlyOneHarnessComponentChanged": {
      "const": true
    },
    "immutableDiffCount": {
      "const": 0
    },
    "behaviorDivergedBeforeVerification": {
      "const": true
    },
    "groundTruthRestorationPassed": {
      "const": true
    },
    "nonGroundTruthRestorationPassed": {
      "const": false
    },
    "goodReplayHashes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "../common.schema.json#/$defs/sha256"
      }
    },
    "faultyReplayHashes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "../common.schema.json#/$defs/sha256"
      }
    },
    "goodReplayHashesIdentical": {
      "const": true
    },
    "faultyReplayHashesIdentical": {
      "const": true
    },
    "reportHash": {
      "$ref": "../common.schema.json#/$defs/sha256"
    }
  }
}
