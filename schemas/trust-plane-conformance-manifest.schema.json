{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://self-evolving-harness.local/schemas/trust-plane-conformance-manifest.schema.json",
  "title": "Signed local runtime and trust-plane conformance manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestId",
    "recordType",
    "scope",
    "sourceSnapshot",
    "evidenceDomains",
    "governanceChains",
    "authorityState",
    "eligibilityState",
    "statusDistinction",
    "outstandingObligations",
    "identityNamespacePolicy",
    "recordedAt",
    "recordedBy",
    "manifestHash",
    "publicPrincipal",
    "attestation"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "manifestId": {
      "$ref": "./common.schema.json#/$defs/entityId"
    },
    "recordType": {
      "const": "trust_plane_conformance_manifest"
    },
    "scope": {
      "const": "local_runtime_and_trust_readiness"
    },
    "sourceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceCommit",
        "sourceTree",
        "remoteTrackingRef",
        "remoteCommit",
        "additionalPushPerformed"
      ],
      "properties": {
        "sourceCommit": {
          "$ref": "#/$defs/gitObjectId"
        },
        "sourceTree": {
          "$ref": "#/$defs/gitObjectId"
        },
        "remoteTrackingRef": {
          "const": "refs/remotes/origin/main"
        },
        "remoteCommit": {
          "$ref": "#/$defs/gitObjectId"
        },
        "additionalPushPerformed": {
          "const": false
        }
      }
    },
    "evidenceDomains": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/evidenceDomain"
      }
    },
    "governanceChains": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/governanceChain"
      }
    },
    "authorityState": {
      "$ref": "./trust-plane-outstanding-obligations.schema.json#/$defs/authorityState"
    },
    "eligibilityState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publicDevelopment",
        "eligibleForHeldOut",
        "eligibleForSealed",
        "eligibleForTemporalHoldout",
        "eligibleForGate",
        "eligibleForFinal",
        "confirmatory",
        "authorizedForResearchEvidence",
        "authorizedForPromotion"
      ],
      "properties": {
        "publicDevelopment": {
          "const": true
        },
        "eligibleForHeldOut": {
          "const": false
        },
        "eligibleForSealed": {
          "const": false
        },
        "eligibleForTemporalHoldout": {
          "const": false
        },
        "eligibleForGate": {
          "const": false
        },
        "eligibleForFinal": {
          "const": false
        },
        "confirmatory": {
          "const": false
        },
        "authorizedForResearchEvidence": {
          "const": false
        },
        "authorizedForPromotion": {
          "const": false
        }
      }
    },
    "statusDistinction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementedControlIds",
        "locallyTestedControlIds",
        "deferredControlIds",
        "unclaimedPropertyIds"
      ],
      "properties": {
        "implementedControlIds": {
          "$ref": "#/$defs/nonEmptyUniqueIds"
        },
        "locallyTestedControlIds": {
          "$ref": "#/$defs/nonEmptyUniqueIds"
        },
        "deferredControlIds": {
          "$ref": "#/$defs/nonEmptyUniqueIds"
        },
        "unclaimedPropertyIds": {
          "$ref": "#/$defs/nonEmptyUniqueIds"
        }
      }
    },
    "outstandingObligations": {
      "$ref": "#/$defs/artifactReference"
    },
    "identityNamespacePolicy": {
      "const": "scope_qualified_no_cross_domain_equivalence"
    },
    "recordedAt": {
      "$ref": "./common.schema.json#/$defs/timestamp"
    },
    "recordedBy": {
      "$ref": "./common.schema.json#/$defs/principalIdentity"
    },
    "manifestHash": {
      "$ref": "./common.schema.json#/$defs/sha256"
    },
    "publicPrincipal": {
      "$ref": "./common.schema.json#/$defs/publicPrincipal"
    },
    "attestation": {
      "$ref": "./common.schema.json#/$defs/attestation"
    }
  },
  "$defs": {
    "gitObjectId": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
    },
    "nonEmptyUniqueIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "./common.schema.json#/$defs/entityId"
      }
    },
    "gitSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "commit",
        "tree"
      ],
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "primary",
            "supporting",
            "evidence",
            "decision"
          ]
        },
        "commit": {
          "$ref": "#/$defs/gitObjectId"
        },
        "tree": {
          "$ref": "#/$defs/gitObjectId"
        }
      }
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "path",
        "sourceCommit",
        "sha256",
        "sizeBytes",
        "mediaType"
      ],
      "properties": {
        "artifactId": {
          "$ref": "./common.schema.json#/$defs/entityId"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "sourceCommit": {
          "$ref": "#/$defs/gitObjectId"
        },
        "sha256": {
          "$ref": "./common.schema.json#/$defs/sha256"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 134217728
        },
        "mediaType": {
          "type": "string",
          "enum": [
            "application/json",
            "text/markdown; charset=utf-8",
            "text/typescript; charset=utf-8"
          ]
        }
      }
    },
    "evidenceAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "jsonPointer",
        "equals"
      ],
      "properties": {
        "artifactId": {
          "$ref": "./common.schema.json#/$defs/entityId"
        },
        "jsonPointer": {
          "type": "string",
          "pattern": "^/(?:[^~/]|~0|~1)*(?:/(?:[^~/]|~0|~1)*)*$",
          "maxLength": 1000
        },
        "equals": {
          "type": [
            "string",
            "boolean",
            "integer",
            "null"
          ]
        }
      }
    },
    "rulingReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "decision",
        "acceptanceAnchors",
        "claimBoundaryAnchor",
        "authorizedNextScopeAnchor"
      ],
      "properties": {
        "artifactId": {
          "$ref": "./common.schema.json#/$defs/entityId"
        },
        "decision": {
          "type": "string",
          "enum": [
            "APPROVE",
            "REVISE"
          ]
        },
        "acceptanceAnchors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 160
          }
        },
        "claimBoundaryAnchor": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160
        },
        "authorizedNextScopeAnchor": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160
        }
      }
    },
    "controlDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementedControlIds",
        "locallyTestedControlIds",
        "deferredControlIds",
        "unclaimedPropertyIds"
      ],
      "properties": {
        "implementedControlIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "./common.schema.json#/$defs/entityId"
          }
        },
        "locallyTestedControlIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "./common.schema.json#/$defs/entityId"
          }
        },
        "deferredControlIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "./common.schema.json#/$defs/entityId"
          }
        },
        "unclaimedPropertyIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "./common.schema.json#/$defs/entityId"
          }
        }
      }
    },
    "identityBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "logicalName",
        "identityKind",
        "value",
        "artifactId",
        "jsonPointer"
      ],
      "properties": {
        "scope": {
          "$ref": "./common.schema.json#/$defs/entityId"
        },
        "logicalName": {
          "$ref": "./common.schema.json#/$defs/entityId"
        },
        "identityKind": {
          "type": "string",
          "enum": [
            "protocol",
            "contract",
            "component_registry",
            "evidence"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "artifactId": {
          "$ref": "./common.schema.json#/$defs/entityId"
        },
        "jsonPointer": {
          "type": "string",
          "pattern": "^/(?:[^~/]|~0|~1)*(?:/(?:[^~/]|~0|~1)*)*$",
          "maxLength": 1000
        }
      }
    },
    "evidenceDomain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domainId",
        "sourceCommits",
        "artifacts",
        "evidenceAssertions",
        "ruling",
        "claimBoundaryReference",
        "contractArtifactIds",
        "controlDisposition",
        "identityBindings"
      ],
      "properties": {
        "domainId": {
          "type": "string",
          "enum": [
            "standalone_runtime_gate2r",
            "development_process_separation",
            "publication_historical_exposure",
            "independent_authorship_vault_admission",
            "durable_serialized_vault_state",
            "eight_principal_vault_os_integration",
            "synthetic_one_time_custody_recovery"
          ]
        },
        "sourceCommits": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/gitSource"
          }
        },
        "artifacts": {
          "type": "array",
          "minItems": 2,
          "maxItems": 24,
          "items": {
            "$ref": "#/$defs/artifactReference"
          }
        },
        "evidenceAssertions": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/evidenceAssertion"
          }
        },
        "ruling": {
          "$ref": "#/$defs/rulingReference"
        },
        "claimBoundaryReference": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifactId",
            "locator"
          ],
          "properties": {
            "artifactId": {
              "$ref": "./common.schema.json#/$defs/entityId"
            },
            "locator": {
              "type": "string",
              "minLength": 2,
              "maxLength": 200
            }
          }
        },
        "contractArtifactIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "./common.schema.json#/$defs/entityId"
          }
        },
        "controlDisposition": {
          "$ref": "#/$defs/controlDisposition"
        },
        "identityBindings": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/identityBinding"
          }
        }
      }
    },
    "governanceChainRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "recordType",
        "predecessorArtifactId",
        "relationship"
      ],
      "properties": {
        "artifactId": {
          "$ref": "./common.schema.json#/$defs/entityId"
        },
        "recordType": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "predecessorArtifactId": {
          "oneOf": [
            {
              "$ref": "./common.schema.json#/$defs/entityId"
            },
            {
              "type": "null"
            }
          ]
        },
        "relationship": {
          "type": "string",
          "enum": [
            "root_deviation",
            "append_only_closure",
            "append_only_superseding_closure"
          ]
        }
      }
    },
    "governanceChain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chainId",
        "appendOnly",
        "records"
      ],
      "properties": {
        "chainId": {
          "type": "string",
          "enum": [
            "hfb_structural_oracle_remediation",
            "public_exposure_remediation"
          ]
        },
        "appendOnly": {
          "const": true
        },
        "records": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/governanceChainRecord"
          }
        }
      }
    }
  }
}
