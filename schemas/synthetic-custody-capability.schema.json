{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://self-evolving-harness.local/schemas/synthetic-custody-capability.schema.json",
  "title": "One-time evaluator capability for an inert synthetic custody release",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordType",
    "deliveryGuarantee",
    "capabilityId",
    "custodyId",
    "protocolId",
    "contractId",
    "contractHash",
    "descriptorHash",
    "taskHandleCommitment",
    "authorCommitmentHash",
    "includedTransitionHash",
    "admittedVaultStateHead",
    "unlockCapabilityHash",
    "plaintextCommitment",
    "recipient",
    "allowedAction",
    "singleUse",
    "reusableDecryptionAuthority",
    "issuedAt",
    "expiresAt",
    "nonce",
    "issuedBy",
    "capabilityHash",
    "publicPrincipal",
    "attestation"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "recordType": {
      "const": "synthetic_custody_capability"
    },
    "deliveryGuarantee": {
      "const": "at_most_once_abort_on_uncertain_delivery"
    },
    "capabilityId": {
      "$ref": "./common.schema.json#/$defs/entityId"
    },
    "custodyId": {
      "$ref": "./common.schema.json#/$defs/entityId"
    },
    "protocolId": {
      "$ref": "./common.schema.json#/$defs/protocolId"
    },
    "contractId": {
      "$ref": "./common.schema.json#/$defs/entityId"
    },
    "contractHash": {
      "$ref": "./common.schema.json#/$defs/sha256"
    },
    "descriptorHash": {
      "$ref": "./common.schema.json#/$defs/sha256"
    },
    "taskHandleCommitment": {
      "$ref": "./common.schema.json#/$defs/sha256"
    },
    "authorCommitmentHash": {
      "$ref": "./common.schema.json#/$defs/sha256"
    },
    "includedTransitionHash": {
      "$ref": "./common.schema.json#/$defs/sha256"
    },
    "admittedVaultStateHead": {
      "$ref": "./common.schema.json#/$defs/sha256"
    },
    "unlockCapabilityHash": {
      "$ref": "./common.schema.json#/$defs/sha256"
    },
    "plaintextCommitment": {
      "$ref": "./common.schema.json#/$defs/sha256"
    },
    "recipient": {
      "$ref": "./common.schema.json#/$defs/principalIdentity"
    },
    "allowedAction": {
      "const": "materialize_once"
    },
    "singleUse": {
      "const": true
    },
    "reusableDecryptionAuthority": {
      "const": false
    },
    "issuedAt": {
      "$ref": "./common.schema.json#/$defs/timestamp"
    },
    "expiresAt": {
      "$ref": "./common.schema.json#/$defs/timestamp"
    },
    "nonce": {
      "type": "string",
      "minLength": 16,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9._:@/-]+$"
    },
    "issuedBy": {
      "$ref": "./common.schema.json#/$defs/principalIdentity"
    },
    "capabilityHash": {
      "$ref": "./common.schema.json#/$defs/sha256"
    },
    "publicPrincipal": {
      "$ref": "./common.schema.json#/$defs/publicPrincipal"
    },
    "attestation": {
      "$ref": "./common.schema.json#/$defs/attestation"
    }
  }
}
