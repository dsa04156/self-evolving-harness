{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://self-evolving-harness.local/schemas/vault-state-transition.schema.json",
  "title": "Authoritative vault task-state and access-decision transition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordType",
    "transitionId",
    "protocolId",
    "contractId",
    "contractHash",
    "requestCommitment",
    "requestIdCommitment",
    "action",
    "taskHandleCommitment",
    "authorshipRecordHash",
    "priorTaskStateRecordHash",
    "priorVaultLedgerHead",
    "leaseOwnerCommitment",
    "leaseEpoch",
    "leaseRecordHash",
    "leaseJournalHead",
    "actorRole",
    "actorIdentityCommitment",
    "actorKeyIdCommitment",
    "capabilityCommitment",
    "inputCommitment",
    "resultCommitment",
    "releasedCommitments",
    "decision",
    "reasonCode",
    "stateBefore",
    "stateAfter",
    "taskStateSuccessor",
    "accessRecord",
    "occurredAt",
    "committedAt",
    "recordedBy",
    "recordHash",
    "publicPrincipal",
    "attestation"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "recordType": {
      "const": "vault_state_transition"
    },
    "transitionId": {
      "$ref": "./common.schema.json#/$defs/entityId"
    },
    "protocolId": {
      "$ref": "./common.schema.json#/$defs/protocolId"
    },
    "contractId": {
      "$ref": "./common.schema.json#/$defs/entityId"
    },
    "contractHash": {
      "$ref": "./common.schema.json#/$defs/sha256"
    },
    "requestCommitment": {
      "$ref": "./common.schema.json#/$defs/sha256"
    },
    "requestIdCommitment": {
      "$ref": "./common.schema.json#/$defs/sha256"
    },
    "action": {
      "type": "string",
      "enum": [
        "create",
        "seal",
        "enumerate",
        "unlock",
        "evaluate",
        "score",
        "audit"
      ]
    },
    "taskHandleCommitment": {
      "$ref": "#/$defs/nullableHash"
    },
    "authorshipRecordHash": {
      "$ref": "#/$defs/nullableHash"
    },
    "priorTaskStateRecordHash": {
      "$ref": "#/$defs/nullableHash"
    },
    "priorVaultLedgerHead": {
      "$ref": "#/$defs/nullableHash"
    },
    "leaseOwnerCommitment": {
      "$ref": "./common.schema.json#/$defs/sha256"
    },
    "leaseEpoch": {
      "type": "integer",
      "minimum": 1
    },
    "leaseRecordHash": {
      "$ref": "./common.schema.json#/$defs/sha256"
    },
    "leaseJournalHead": {
      "$ref": "./common.schema.json#/$defs/sha256"
    },
    "actorRole": {
      "$ref": "./common.schema.json#/$defs/principalRole"
    },
    "actorIdentityCommitment": {
      "$ref": "./common.schema.json#/$defs/sha256"
    },
    "actorKeyIdCommitment": {
      "$ref": "./common.schema.json#/$defs/sha256"
    },
    "capabilityCommitment": {
      "$ref": "#/$defs/nullableHash"
    },
    "inputCommitment": {
      "$ref": "#/$defs/nullableHash"
    },
    "resultCommitment": {
      "$ref": "#/$defs/nullableHash"
    },
    "releasedCommitments": {
      "type": "array",
      "items": {
        "$ref": "./common.schema.json#/$defs/sha256"
      },
      "uniqueItems": true
    },
    "decision": {
      "type": "string",
      "enum": [
        "allowed",
        "denied"
      ]
    },
    "reasonCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,95}$"
    },
    "stateBefore": {
      "$ref": "#/$defs/nullableVaultState"
    },
    "stateAfter": {
      "$ref": "#/$defs/nullableVaultState"
    },
    "taskStateSuccessor": {
      "type": "boolean"
    },
    "accessRecord": {
      "$ref": "./vault-access-record.schema.json"
    },
    "occurredAt": {
      "$ref": "./common.schema.json#/$defs/timestamp"
    },
    "committedAt": {
      "$ref": "./common.schema.json#/$defs/timestamp"
    },
    "recordedBy": {
      "$ref": "./common.schema.json#/$defs/principalIdentity"
    },
    "recordHash": {
      "$ref": "./common.schema.json#/$defs/sha256"
    },
    "publicPrincipal": {
      "$ref": "./common.schema.json#/$defs/publicPrincipal"
    },
    "attestation": {
      "$ref": "./common.schema.json#/$defs/attestation"
    }
  },
  "$defs": {
    "nullableHash": {
      "oneOf": [
        {
          "$ref": "./common.schema.json#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "vaultState": {
      "type": "string",
      "enum": [
        "created",
        "sealed",
        "unlocked",
        "evaluated",
        "scored"
      ]
    },
    "nullableVaultState": {
      "oneOf": [
        {
          "$ref": "#/$defs/vaultState"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
