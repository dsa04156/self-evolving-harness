{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://self-evolving-harness.local/schemas/descendant-record.schema.json",
  "title": "Signed Descendant Lifecycle Record",
  "description": "Append-only subagent/backend-job state with inherited pins, reduced authority, and a bounded budget slice.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordId",
    "descendantId",
    "parentSessionId",
    "kind",
    "state",
    "pins",
    "budgetSlice",
    "permissionToolIds",
    "taskHash",
    "createdAt",
    "artifactHash",
    "failureCode",
    "delegatedBy",
    "attestation"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "recordId": { "$ref": "./common.schema.json#/$defs/entityId" },
    "descendantId": { "$ref": "./common.schema.json#/$defs/entityId" },
    "parentSessionId": { "$ref": "./common.schema.json#/$defs/entityId" },
    "kind": { "enum": ["subagent", "backend_job"] },
    "state": {
      "enum": ["created", "running", "completed", "failed", "cancelled", "orphan_reaped"]
    },
    "pins": { "$ref": "#/$defs/sessionPins" },
    "budgetSlice": { "$ref": "#/$defs/budgetLimits" },
    "permissionToolIds": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 128,
      "items": { "$ref": "./common.schema.json#/$defs/entityId" }
    },
    "taskHash": { "$ref": "./common.schema.json#/$defs/sha256" },
    "createdAt": { "$ref": "./common.schema.json#/$defs/timestamp" },
    "artifactHash": {
      "oneOf": [
        { "$ref": "./common.schema.json#/$defs/sha256" },
        { "type": "null" }
      ]
    },
    "failureCode": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 160
    },
    "delegatedBy": { "$ref": "./common.schema.json#/$defs/principalIdentity" },
    "attestation": { "$ref": "./common.schema.json#/$defs/attestation" }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "enum": ["created", "running"] } } },
      "then": {
        "properties": {
          "artifactHash": { "type": "null" },
          "failureCode": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "state": { "const": "completed" } } },
      "then": {
        "properties": {
          "artifactHash": { "$ref": "./common.schema.json#/$defs/sha256" },
          "failureCode": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": { "enum": ["failed", "cancelled", "orphan_reaped"] }
        }
      },
      "then": {
        "properties": {
          "failureCode": { "type": "string", "minLength": 1, "maxLength": 160 }
        }
      }
    }
  ],
  "$defs": {
    "budgetLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxModelCalls",
        "maxInputTokens",
        "maxOutputTokens",
        "maxToolCalls",
        "maxWallClockMillis",
        "maxRetries",
        "maxDescendants"
      ],
      "properties": {
        "maxModelCalls": { "type": "integer", "minimum": 0 },
        "maxInputTokens": { "type": "integer", "minimum": 0 },
        "maxOutputTokens": { "type": "integer", "minimum": 0 },
        "maxToolCalls": { "type": "integer", "minimum": 0 },
        "maxWallClockMillis": { "type": "integer", "minimum": 0 },
        "maxRetries": { "type": "integer", "minimum": 0 },
        "maxDescendants": { "type": "integer", "minimum": 0 }
      }
    },
    "sessionPins": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolId",
        "harnessVersionId",
        "runtimeStateSnapshotId",
        "modelIdentityHash",
        "permissionPolicyHash",
        "safetyPolicyHash",
        "budgetPolicyHash",
        "budgetAccountId",
        "datasetPermissions"
      ],
      "properties": {
        "protocolId": { "$ref": "./common.schema.json#/$defs/protocolId" },
        "harnessVersionId": { "$ref": "./common.schema.json#/$defs/harnessVersionId" },
        "runtimeStateSnapshotId": { "$ref": "./common.schema.json#/$defs/entityId" },
        "modelIdentityHash": { "$ref": "./common.schema.json#/$defs/sha256" },
        "permissionPolicyHash": { "$ref": "./common.schema.json#/$defs/sha256" },
        "safetyPolicyHash": { "$ref": "./common.schema.json#/$defs/sha256" },
        "budgetPolicyHash": { "$ref": "./common.schema.json#/$defs/sha256" },
        "budgetAccountId": { "$ref": "./common.schema.json#/$defs/entityId" },
        "datasetPermissions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "./common.schema.json#/$defs/datasetRole" }
        }
      }
    }
  }
}
