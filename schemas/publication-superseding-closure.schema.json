{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://self-evolving-harness.local/schemas/publication-superseding-closure.schema.json",
  "title": "Signed superseding closure for historical public-exposure completeness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "closureId",
    "recordType",
    "governanceDomainId",
    "deviationId",
    "deviationRecordHash",
    "priorClosureId",
    "priorClosureHash",
    "priorClosureFileSha256",
    "correctiveDecision",
    "historicalInventoryId",
    "historicalInventoryHash",
    "historicalLedgerId",
    "historicalLedgerHash",
    "expandedSecretScan",
    "validatorEvidence",
    "remediation",
    "claimBoundary",
    "closedAt",
    "recordedBy",
    "recordHash",
    "publicPrincipal",
    "attestation"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "closureId": {
      "$ref": "./common.schema.json#/$defs/entityId"
    },
    "recordType": {
      "const": "publication_superseding_closure"
    },
    "governanceDomainId": {
      "$ref": "./common.schema.json#/$defs/entityId"
    },
    "deviationId": {
      "$ref": "./common.schema.json#/$defs/entityId"
    },
    "deviationRecordHash": {
      "$ref": "./common.schema.json#/$defs/sha256"
    },
    "priorClosureId": {
      "$ref": "./common.schema.json#/$defs/entityId"
    },
    "priorClosureHash": {
      "$ref": "./common.schema.json#/$defs/sha256"
    },
    "priorClosureFileSha256": {
      "$ref": "./common.schema.json#/$defs/sha256"
    },
    "correctiveDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "round",
        "decision",
        "responsePath",
        "responseSha256"
      ],
      "properties": {
        "round": {
          "const": "03RRRRR"
        },
        "decision": {
          "const": "REVISE"
        },
        "responsePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "responseSha256": {
          "const": "sha256:9df707631279d1b423822c9e3011e3b564a245a09660217912dc8297577cd267"
        }
      }
    },
    "historicalInventoryId": {
      "$ref": "./common.schema.json#/$defs/entityId"
    },
    "historicalInventoryHash": {
      "$ref": "./common.schema.json#/$defs/sha256"
    },
    "historicalLedgerId": {
      "$ref": "./common.schema.json#/$defs/entityId"
    },
    "historicalLedgerHash": {
      "$ref": "./common.schema.json#/$defs/sha256"
    },
    "expandedSecretScan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uniqueBlobsScanned",
        "historicalOnlyBlobsScanned",
        "correctiveOnlyBlobsScanned",
        "environmentFilesFound",
        "actualSecretMatches"
      ],
      "properties": {
        "uniqueBlobsScanned": {
          "type": "integer",
          "minimum": 1
        },
        "historicalOnlyBlobsScanned": {
          "type": "integer",
          "minimum": 0
        },
        "correctiveOnlyBlobsScanned": {
          "type": "integer",
          "minimum": 1
        },
        "environmentFilesFound": {
          "const": 0
        },
        "actualSecretMatches": {
          "const": 0
        }
      }
    },
    "validatorEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementationPath",
        "implementationSha256",
        "testPath",
        "testSha256",
        "verifierPath",
        "verifierSha256"
      ],
      "properties": {
        "implementationPath": {
          "$ref": "#/$defs/path"
        },
        "implementationSha256": {
          "$ref": "./common.schema.json#/$defs/sha256"
        },
        "testPath": {
          "$ref": "#/$defs/path"
        },
        "testSha256": {
          "$ref": "./common.schema.json#/$defs/sha256"
        },
        "verifierPath": {
          "$ref": "#/$defs/path"
        },
        "verifierSha256": {
          "$ref": "./common.schema.json#/$defs/sha256"
        }
      }
    },
    "remediation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "priorClosureModified",
        "priorClosureWasPremature",
        "closureStatus",
        "completedActions",
        "outstandingActions"
      ],
      "properties": {
        "priorClosureModified": {
          "const": false
        },
        "priorClosureWasPremature": {
          "const": true
        },
        "closureStatus": {
          "const": "superseded_by_complete_historical_union"
        },
        "completedActions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "outstandingActions": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "claimBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "historicalPublicationGovernanceClosed",
        "publicDevelopmentArtifactsPermanent",
        "heldOutEligibilityRestored",
        "researchEvidenceAuthorized",
        "promotionAuthorized",
        "providerUsed",
        "selfImprovementClaim",
        "additionalPushPerformed"
      ],
      "properties": {
        "historicalPublicationGovernanceClosed": {
          "const": true
        },
        "publicDevelopmentArtifactsPermanent": {
          "const": true
        },
        "heldOutEligibilityRestored": {
          "const": false
        },
        "researchEvidenceAuthorized": {
          "const": false
        },
        "promotionAuthorized": {
          "const": false
        },
        "providerUsed": {
          "const": false
        },
        "selfImprovementClaim": {
          "const": false
        },
        "additionalPushPerformed": {
          "const": false
        }
      }
    },
    "closedAt": {
      "$ref": "./common.schema.json#/$defs/timestamp"
    },
    "recordedBy": {
      "$ref": "./common.schema.json#/$defs/principalIdentity"
    },
    "recordHash": {
      "$ref": "./common.schema.json#/$defs/sha256"
    },
    "publicPrincipal": {
      "$ref": "#/$defs/publicPrincipal"
    },
    "attestation": {
      "$ref": "./common.schema.json#/$defs/attestation"
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "publicPrincipal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "keyId",
        "publicKeyPem"
      ],
      "properties": {
        "identity": {
          "$ref": "./common.schema.json#/$defs/principalIdentity"
        },
        "keyId": {
          "$ref": "./common.schema.json#/$defs/entityId"
        },
        "publicKeyPem": {
          "type": "string",
          "pattern": "^-----BEGIN PUBLIC KEY-----\\n[A-Za-z0-9+/=\\n]+-----END PUBLIC KEY-----\\n$",
          "maxLength": 1000
        }
      }
    }
  }
}
