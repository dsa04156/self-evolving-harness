            "sourceTree": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
            "sha256": { "$ref": "./common.schema.json#/$defs/sha256" },
            "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 16777216 }
          }
        },
        "verifierArtifactId": { "const": "calibration_contract_verifier" },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaValid", "signatureValid", "sourceBindingsValid", "numericInventoryUnchanged", "derivationContractComplete", "authoritySeparationValid", "mountSourcesDisjoint", "messageAndRecordOwnershipValid", "evidenceGraphComplete", "zeroExecutionAndAuthorityValid", "forbiddenDataAbsent", "finalIdentitiesAbsent", "authoritiesGranted"],
          "properties": {
            "schemaValid": { "const": true },
            "signatureValid": { "const": true },
            "sourceBindingsValid": { "const": true },
            "numericInventoryUnchanged": { "const": true },
            "derivationContractComplete": { "const": true },
            "authoritySeparationValid": { "const": true },
            "mountSourcesDisjoint": { "const": true },
            "messageAndRecordOwnershipValid": { "const": true },
            "evidenceGraphComplete": { "const": true },
            "zeroExecutionAndAuthorityValid": { "const": true },
            "forbiddenDataAbsent": { "const": true },
            "finalIdentitiesAbsent": { "const": true },
            "authoritiesGranted": { "const": 0 }
          }
        },
        "verifiedAt": { "$ref": "./common.schema.json#/$defs/timestamp" },
        "producer": { "$ref": "./common.schema.json#/$defs/principalIdentity" },
        "receiptHash": { "$ref": "./common.schema.json#/$defs/sha256" },
        "publicPrincipal": { "$ref": "./common.schema.json#/$defs/publicPrincipal" },
        "attestation": { "$ref": "./common.schema.json#/$defs/attestation" }
      }
    }
  }
