{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://self-evolving-harness.local/schemas/synthetic-custody-final-audit.schema.json",
  "title": "Commitment-only final audit for the synthetic custody rehearsal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordType",
    "protocolId",
    "contractHash",
    "descriptorHashes",
    "transitionHashes",
    "roleReceiptHashes",
    "leakageScanHashes",
    "scorerProjectionHash",
    "promoterProjectionHash",
    "taskBodyPresent",
    "verifierLogicPresent",
    "labelPresent",
    "taskPathPresent",
    "modelPromptPresent",
    "providerUsed",
    "researchEvidenceAuthorized",
    "promotionAuthorized",
    "finalizedAt",
    "finalizedBy",
    "recordHash",
    "publicPrincipal",
    "attestation"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "recordType": {
      "const": "synthetic_custody_final_audit"
    },
    "protocolId": {
      "$ref": "./common.schema.json#/$defs/protocolId"
    },
    "contractHash": {
      "$ref": "./common.schema.json#/$defs/sha256"
    },
    "descriptorHashes": {
      "$ref": "#/$defs/nonEmptyHashArray"
    },
    "transitionHashes": {
      "$ref": "#/$defs/nonEmptyHashArray"
    },
    "roleReceiptHashes": {
      "$ref": "#/$defs/nonEmptyHashArray"
    },
    "leakageScanHashes": {
      "$ref": "#/$defs/nonEmptyHashArray"
    },
    "scorerProjectionHash": {
      "$ref": "./common.schema.json#/$defs/sha256"
    },
    "promoterProjectionHash": {
      "$ref": "./common.schema.json#/$defs/sha256"
    },
    "taskBodyPresent": {
      "const": false
    },
    "verifierLogicPresent": {
      "const": false
    },
    "labelPresent": {
      "const": false
    },
    "taskPathPresent": {
      "const": false
    },
    "modelPromptPresent": {
      "const": false
    },
    "providerUsed": {
      "const": false
    },
    "researchEvidenceAuthorized": {
      "const": false
    },
    "promotionAuthorized": {
      "const": false
    },
    "finalizedAt": {
      "$ref": "./common.schema.json#/$defs/timestamp"
    },
    "finalizedBy": {
      "$ref": "./common.schema.json#/$defs/principalIdentity"
    },
    "recordHash": {
      "$ref": "./common.schema.json#/$defs/sha256"
    },
    "publicPrincipal": {
      "$ref": "./common.schema.json#/$defs/publicPrincipal"
    },
    "attestation": {
      "$ref": "./common.schema.json#/$defs/attestation"
    }
  },
  "$defs": {
    "nonEmptyHashArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "./common.schema.json#/$defs/sha256"
      }
    }
  }
}
