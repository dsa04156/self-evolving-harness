{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://self-evolving-harness.local/schemas/deployment-pointer-record.schema.json",
  "title": "Atomic Whole-Harness DeploymentPointerRecord",
  "description": "The complete production-channel post-state: generation, target tuple, rollback-target tuple, and exact prior tuple used by CAS. Rollback uses deterministic swap semantics.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordId",
    "protocolId",
    "channelId",
    "operation",
    "expectedBefore",
    "after",
    "deploymentDecisionId",
    "targetQualificationDecisionId",
    "rollbackTargetHarnessVersionId",
    "rollbackTargetManifestHash",
    "rollbackTargetQualificationDecisionId",
    "priorTargetDisposition",
    "appliedBy",
    "appliedAt",
    "auditLink",
    "attestation"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "recordId": {
      "$ref": "./common.schema.json#/$defs/entityId"
    },
    "protocolId": {
      "$ref": "./common.schema.json#/$defs/protocolId"
    },
    "channelId": {
      "const": "production"
    },
    "operation": {
      "type": "string",
      "enum": [
        "initialize",
        "deploy",
        "rollback",
        "decommission"
      ]
    },
    "expectedBefore": {
      "$ref": "./deployment-decision.schema.json#/$defs/pointerExpectation"
    },
    "after": {
      "$ref": "./deployment-decision.schema.json#/$defs/pointerTarget"
    },
    "deploymentDecisionId": {
      "$ref": "./common.schema.json#/$defs/entityId"
    },
    "targetQualificationDecisionId": {
      "$ref": "./deployment-decision.schema.json#/$defs/nullableEntityId"
    },
    "rollbackTargetHarnessVersionId": {
      "$ref": "./deployment-decision.schema.json#/$defs/nullableHarnessVersionId"
    },
    "rollbackTargetManifestHash": {
      "$ref": "./deployment-decision.schema.json#/$defs/nullableSha256"
    },
    "rollbackTargetQualificationDecisionId": {
      "$ref": "./deployment-decision.schema.json#/$defs/nullableEntityId"
    },
    "priorTargetDisposition": {
      "type": "string",
      "enum": [
        "none",
        "retained_approved"
      ]
    },
    "appliedBy": {
      "$ref": "./common.schema.json#/$defs/principalIdentity"
    },
    "appliedAt": {
      "$ref": "./common.schema.json#/$defs/timestamp"
    },
    "auditLink": {
      "$ref": "./common.schema.json#/$defs/auditLink"
    },
    "attestation": {
      "$ref": "./common.schema.json#/$defs/attestation"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "decommission"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "after": {
            "properties": {
              "harnessVersionId": {
                "type": "null"
              },
              "manifestHash": {
                "type": "null"
              }
            }
          },
          "targetQualificationDecisionId": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "after": {
            "properties": {
              "harnessVersionId": {
                "$ref": "./common.schema.json#/$defs/harnessVersionId"
              },
              "manifestHash": {
                "$ref": "./common.schema.json#/$defs/sha256"
              }
            }
          },
          "targetQualificationDecisionId": {
            "$ref": "./common.schema.json#/$defs/entityId"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "initialize",
              "decommission"
            ]
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "rollbackTargetHarnessVersionId": {
            "type": "null"
          },
          "rollbackTargetManifestHash": {
            "type": "null"
          },
          "rollbackTargetQualificationDecisionId": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "rollbackTargetHarnessVersionId": {
            "$ref": "./common.schema.json#/$defs/harnessVersionId"
          },
          "rollbackTargetManifestHash": {
            "$ref": "./common.schema.json#/$defs/sha256"
          },
          "rollbackTargetQualificationDecisionId": {
            "$ref": "./common.schema.json#/$defs/entityId"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "initialize"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "expectedBefore": {
            "properties": {
              "generation": {
                "const": -1
              },
              "harnessVersionId": {
                "type": "null"
              },
              "manifestHash": {
                "type": "null"
              },
              "targetQualificationDecisionId": {
                "type": "null"
              },
              "rollbackTargetHarnessVersionId": {
                "type": "null"
              },
              "rollbackTargetManifestHash": {
                "type": "null"
              },
              "rollbackTargetQualificationDecisionId": {
                "type": "null"
              },
              "pointerRecordHash": {
                "type": "null"
              }
            }
          },
          "after": {
            "properties": {
              "generation": {
                "const": 0
              }
            }
          },
          "priorTargetDisposition": {
            "const": "none"
          }
        }
      },
      "else": {
        "properties": {
          "expectedBefore": {
            "properties": {
              "generation": {
                "minimum": 0
              },
              "harnessVersionId": {
                "$ref": "./common.schema.json#/$defs/harnessVersionId"
              },
              "manifestHash": {
                "$ref": "./common.schema.json#/$defs/sha256"
              },
              "targetQualificationDecisionId": {
                "$ref": "./common.schema.json#/$defs/entityId"
              },
              "pointerRecordHash": {
                "$ref": "./common.schema.json#/$defs/sha256"
              }
            }
          },
          "priorTargetDisposition": {
            "const": "retained_approved"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "rollback"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "expectedBefore": {
            "properties": {
              "rollbackTargetHarnessVersionId": {
                "$ref": "./common.schema.json#/$defs/harnessVersionId"
              },
              "rollbackTargetManifestHash": {
                "$ref": "./common.schema.json#/$defs/sha256"
              },
              "rollbackTargetQualificationDecisionId": {
                "$ref": "./common.schema.json#/$defs/entityId"
              }
            }
          }
        }
      }
    }
  ]
}
