{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://self-evolving-harness.local/schemas/trust-plane-outstanding-obligations.schema.json",
  "title": "Trust-plane outstanding obligations matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "matrixId",
    "recordType",
    "statusAsOf",
    "scope",
    "obligations",
    "authorityState"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "matrixId": {
      "$ref": "./common.schema.json#/$defs/entityId"
    },
    "recordType": {
      "const": "trust_plane_outstanding_obligations"
    },
    "statusAsOf": {
      "$ref": "./common.schema.json#/$defs/timestamp"
    },
    "scope": {
      "const": "local_runtime_and_trust_readiness"
    },
    "obligations": {
      "type": "array",
      "minItems": 7,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "obligationId",
          "status",
          "evidencePresent",
          "requiredEvidenceClass",
          "blocks"
        ],
        "properties": {
          "obligationId": {
            "type": "string",
            "enum": [
              "real_provider_receipt",
              "real_benchmark_custody",
              "research_protocol_numeric_freeze",
              "b0_b6_research_execution",
              "held_out_confirmatory_attribution",
              "research_candidate_selection_promotion",
              "performance_generalization_security_evolution_results"
            ]
          },
          "status": {
            "const": "unresolved"
          },
          "evidencePresent": {
            "const": false
          },
          "requiredEvidenceClass": {
            "type": "string",
            "minLength": 3,
            "maxLength": 160
          },
          "blocks": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "provider_readiness",
                "real_data_custody",
                "research_protocol_freeze",
                "research_execution",
                "confirmatory_claim",
                "promotion",
                "performance_claim",
                "generalization_claim",
                "security_certification",
                "evolution_claim",
                "self_improvement_claim"
              ]
            }
          }
        }
      }
    },
    "authorityState": {
      "$ref": "#/$defs/authorityState"
    }
  },
  "$defs": {
    "authorityState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerExecutionAuthorized",
        "researchEvidenceAuthorized",
        "candidateSelectionAuthorized",
        "promotionAuthorized",
        "deploymentAuthorized",
        "claimAuthorityGranted"
      ],
      "properties": {
        "providerExecutionAuthorized": {
          "const": false
        },
        "researchEvidenceAuthorized": {
          "const": false
        },
        "candidateSelectionAuthorized": {
          "const": false
        },
        "promotionAuthorized": {
          "const": false
        },
        "deploymentAuthorized": {
          "const": false
        },
        "claimAuthorityGranted": {
          "const": false
        }
      }
    }
  }
}
