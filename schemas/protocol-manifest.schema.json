{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://self-evolving-harness.local/schemas/protocol-manifest.schema.json",
  "title": "Immutable ProtocolManifest",
  "description": "Every trust-plane, evaluation, benchmark, budget, environment, and statistical input is digest-pinned. Any identity change creates a new protocol and evidence cannot be pooled across IDs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "protocolId",
    "manifestHash",
    "identity"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "protocolId": {
      "$ref": "./common.schema.json#/$defs/protocolId"
    },
    "manifestHash": {
      "$ref": "./common.schema.json#/$defs/sha256"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalizationProfile",
        "semanticVersion",
        "purpose",
        "createdAt",
        "typeRegistryId",
        "pins"
      ],
      "properties": {
        "canonicalizationProfile": {
          "const": "seh-jcs-v1"
        },
        "semanticVersion": {
          "$ref": "./common.schema.json#/$defs/semanticVersion"
        },
        "purpose": {
          "type": "string",
          "enum": [
            "development",
            "pilot",
            "confirmatory",
            "replication"
          ]
        },
        "createdAt": {
          "$ref": "./common.schema.json#/$defs/timestamp"
        },
        "typeRegistryId": {
          "$ref": "./common.schema.json#/$defs/typeRegistryId"
        },
        "pins": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaSet",
            "payloadContracts",
            "runtimeKernel",
            "runtimeContract",
            "evaluator",
            "benchmarkMaterial",
            "splitManifest",
            "permissionPolicy",
            "safetyPolicy",
            "budgetPolicy",
            "modelConfiguration",
            "traceCollector",
            "auditVerifier",
            "promotionPolicy",
            "optimizer",
            "toolImplementations",
            "middleware",
            "environment",
            "toolchain",
            "principalCapabilityMatrix",
            "wireProtocol",
            "dataAccessPolicy",
            "gateFeedbackPolicy",
            "baselineMatrix",
            "statisticalPlan",
            "fixtureSpecification"
          ],
          "properties": {
            "schemaSet": {"$ref": "./common.schema.json#/$defs/sha256"},
            "payloadContracts": {"$ref": "./common.schema.json#/$defs/sha256"},
            "runtimeKernel": {"$ref": "./common.schema.json#/$defs/sha256"},
            "runtimeContract": {"$ref": "./common.schema.json#/$defs/sha256"},
            "evaluator": {"$ref": "./common.schema.json#/$defs/sha256"},
            "benchmarkMaterial": {"$ref": "./common.schema.json#/$defs/sha256"},
            "splitManifest": {"$ref": "./common.schema.json#/$defs/sha256"},
            "permissionPolicy": {"$ref": "./common.schema.json#/$defs/sha256"},
            "safetyPolicy": {"$ref": "./common.schema.json#/$defs/sha256"},
            "budgetPolicy": {"$ref": "./common.schema.json#/$defs/sha256"},
            "modelConfiguration": {"$ref": "./common.schema.json#/$defs/sha256"},
            "traceCollector": {"$ref": "./common.schema.json#/$defs/sha256"},
            "auditVerifier": {"$ref": "./common.schema.json#/$defs/sha256"},
            "promotionPolicy": {"$ref": "./common.schema.json#/$defs/sha256"},
            "optimizer": {"$ref": "./common.schema.json#/$defs/sha256"},
            "toolImplementations": {"$ref": "./common.schema.json#/$defs/sha256"},
            "middleware": {"$ref": "./common.schema.json#/$defs/sha256"},
            "environment": {"$ref": "./common.schema.json#/$defs/sha256"},
            "toolchain": {"$ref": "./common.schema.json#/$defs/sha256"},
            "principalCapabilityMatrix": {"$ref": "./common.schema.json#/$defs/sha256"},
            "wireProtocol": {"$ref": "./common.schema.json#/$defs/sha256"},
            "dataAccessPolicy": {"$ref": "./common.schema.json#/$defs/sha256"},
            "gateFeedbackPolicy": {"$ref": "./common.schema.json#/$defs/sha256"},
            "baselineMatrix": {"$ref": "./common.schema.json#/$defs/sha256"},
            "statisticalPlan": {"$ref": "./common.schema.json#/$defs/sha256"},
            "fixtureSpecification": {"$ref": "./common.schema.json#/$defs/sha256"}
          }
        }
      }
    }
  }
}
