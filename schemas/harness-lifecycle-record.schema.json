{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://self-evolving-harness.local/schemas/harness-lifecycle-record.schema.json",
  "title": "Append-Only Harness Qualification Lifecycle Record",
  "description": "Qualification is projected from immutable records. Deployment is represented only by channel-scoped DeploymentPointerRecord objects.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordId",
    "protocolId",
    "harnessVersionId",
    "fromState",
    "toState",
    "evidenceReceiptIds",
    "transitionedBy",
    "transitionedAt",
    "auditLink",
    "attestation"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "recordId": {
      "$ref": "./common.schema.json#/$defs/entityId"
    },
    "protocolId": {
      "$ref": "./common.schema.json#/$defs/protocolId"
    },
    "harnessVersionId": {
      "$ref": "./common.schema.json#/$defs/harnessVersionId"
    },
    "fromState": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "draft",
        "candidate",
        "statically_validated",
        "evaluating",
        "canary",
        "approved",
        "rejected",
        "retired"
      ]
    },
    "toState": {
      "type": "string",
      "enum": [
        "draft",
        "candidate",
        "statically_validated",
        "evaluating",
        "canary",
        "approved",
        "rejected",
        "retired"
      ]
    },
    "evidenceReceiptIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "./common.schema.json#/$defs/entityId"
      }
    },
    "transitionedBy": {
      "$ref": "./common.schema.json#/$defs/principalIdentity"
    },
    "transitionedAt": {
      "$ref": "./common.schema.json#/$defs/timestamp"
    },
    "auditLink": {
      "$ref": "./common.schema.json#/$defs/auditLink"
    },
    "attestation": {
      "$ref": "./common.schema.json#/$defs/attestation"
    }
  },
  "oneOf": [
    {
      "properties": {
        "fromState": {"type": "null"},
        "toState": {"const": "draft"}
      }
    },
    {
      "properties": {
        "fromState": {"const": "draft"},
        "toState": {"enum": ["candidate", "rejected"]}
      }
    },
    {
      "properties": {
        "fromState": {"const": "candidate"},
        "toState": {"enum": ["statically_validated", "rejected"]}
      }
    },
    {
      "properties": {
        "fromState": {"const": "statically_validated"},
        "toState": {"enum": ["evaluating", "rejected"]}
      }
    },
    {
      "properties": {
        "fromState": {"const": "evaluating"},
        "toState": {"enum": ["canary", "rejected"]}
      }
    },
    {
      "properties": {
        "fromState": {"const": "canary"},
        "toState": {"enum": ["approved", "rejected"]}
      }
    },
    {
      "properties": {
        "fromState": {"const": "approved"},
        "toState": {"const": "retired"}
      }
    },
    {
      "properties": {
        "fromState": {"const": "rejected"},
        "toState": {"const": "retired"}
      }
    }
  ]
}
