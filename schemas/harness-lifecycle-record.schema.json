{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://self-evolving-harness.local/schemas/harness-lifecycle-record.schema.json",
  "title": "Append-Only HarnessLifecycleRecord",
  "description": "Lifecycle state is a projection over these immutable records and is never embedded in HarnessVersionManifest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordId",
    "protocolId",
    "harnessVersionId",
    "fromState",
    "toState",
    "evidenceReceiptIds",
    "transitionedBy",
    "transitionedAt",
    "auditLink",
    "attestation"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "recordId": {
      "$ref": "./common.schema.json#/$defs/entityId"
    },
    "protocolId": {
      "$ref": "./common.schema.json#/$defs/protocolId"
    },
    "harnessVersionId": {
      "$ref": "./common.schema.json#/$defs/harnessVersionId"
    },
    "fromState": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "draft",
        "candidate",
        "statically_validated",
        "evaluating",
        "canary",
        "active",
        "retired",
        "rejected",
        "rolled_back"
      ]
    },
    "toState": {
      "type": "string",
      "enum": [
        "draft",
        "candidate",
        "statically_validated",
        "evaluating",
        "canary",
        "active",
        "retired",
        "rejected",
        "rolled_back"
      ]
    },
    "evidenceReceiptIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "./common.schema.json#/$defs/entityId"
      }
    },
    "transitionedBy": {
      "$ref": "./common.schema.json#/$defs/principalIdentity"
    },
    "transitionedAt": {
      "$ref": "./common.schema.json#/$defs/timestamp"
    },
    "auditLink": {
      "$ref": "./common.schema.json#/$defs/auditLink"
    },
    "attestation": {
      "$ref": "./common.schema.json#/$defs/attestation"
    }
  }
}
