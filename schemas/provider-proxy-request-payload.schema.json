{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://self-evolving-harness.local/schemas/provider-proxy-request-payload.schema.json",
  "title": "Provider Proxy Wire Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "providerSmokeManifestId",
    "phaseAccountId",
    "modelRequestHash",
    "modelRequest"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "providerSmokeManifestId": {
      "type": "string",
      "pattern": "^psm-sha256:[a-f0-9]{64}$"
    },
    "phaseAccountId": {
      "$ref": "./common.schema.json#/$defs/entityId"
    },
    "modelRequestHash": {
      "$ref": "./common.schema.json#/$defs/sha256"
    },
    "modelRequest": {
      "$ref": "#/$defs/modelRequest"
    }
  },
  "$defs": {
    "modelRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "modelIdentity",
        "instructions",
        "input",
        "tools",
        "maxOutputTokens",
        "reasoningEffort"
      ],
      "properties": {
        "requestId": {
          "$ref": "./common.schema.json#/$defs/entityId"
        },
        "modelIdentity": {
          "$ref": "./common.schema.json#/$defs/entityId"
        },
        "instructions": {
          "type": "string",
          "maxLength": 1048576
        },
        "input": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "role",
              "content"
            ],
            "properties": {
              "kind": {
                "const": "text"
              },
              "role": {
                "type": "string",
                "enum": [
                  "system",
                  "user",
                  "assistant"
                ]
              },
              "content": {
                "type": "string",
                "maxLength": 1048576
              }
            }
          }
        },
        "tools": {
          "type": "array",
          "maxItems": 0
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 131072
        },
        "reasoningEffort": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "none",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        }
      }
    }
  }
}
