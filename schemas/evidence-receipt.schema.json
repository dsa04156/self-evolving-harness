{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://self-evolving-harness.local/schemas/evidence-receipt.schema.json",
  "title": "EvidenceReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "receiptId",
    "protocolId",
    "receiptType",
    "subjectIds",
    "harnessVersionIds",
    "runtimeStateSnapshotIds",
    "eventRanges",
    "recordedObservationEventIds",
    "verifierOutcomeEventIds",
    "inferenceEventIds",
    "artifactRefs",
    "producer",
    "createdAt",
    "receiptHash",
    "auditLink",
    "attestation"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "receiptId": {
      "$ref": "./common.schema.json#/$defs/entityId"
    },
    "protocolId": {
      "$ref": "./common.schema.json#/$defs/protocolId"
    },
    "receiptType": {
      "type": "string",
      "enum": [
        "session_initialization",
        "session_checkpoint",
        "session_completion",
        "static_validation",
        "evaluation",
        "gate_release",
        "promotion",
        "rejection",
        "rollback",
        "artifact_retention",
        "budget_usage",
        "audit_replay",
        "protocol_freeze"
      ]
    },
    "subjectIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "./common.schema.json#/$defs/entityId"
      }
    },
    "harnessVersionIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "./common.schema.json#/$defs/harnessVersionId"
      }
    },
    "runtimeStateSnapshotIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^rss-sha256:[a-f0-9]{64}$"
      }
    },
    "eventRanges": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sessionId",
          "firstSequence",
          "lastSequence",
          "headHash"
        ],
        "properties": {
          "sessionId": {
            "$ref": "./common.schema.json#/$defs/entityId"
          },
          "firstSequence": {
            "type": "integer",
            "minimum": 0
          },
          "lastSequence": {
            "type": "integer",
            "minimum": 0
          },
          "headHash": {
            "$ref": "./common.schema.json#/$defs/sha256"
          }
        }
      }
    },
    "recordedObservationEventIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "./common.schema.json#/$defs/entityId"
      }
    },
    "verifierOutcomeEventIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "./common.schema.json#/$defs/entityId"
      }
    },
    "inferenceEventIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "./common.schema.json#/$defs/entityId"
      }
    },
    "artifactRefs": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "./common.schema.json#/$defs/artifactRef"
      }
    },
    "producer": {
      "$ref": "./common.schema.json#/$defs/principalIdentity"
    },
    "createdAt": {
      "$ref": "./common.schema.json#/$defs/timestamp"
    },
    "receiptHash": {
      "$ref": "./common.schema.json#/$defs/sha256"
    },
    "auditLink": {
      "$ref": "./common.schema.json#/$defs/auditLink"
    },
    "attestation": {
      "$ref": "./common.schema.json#/$defs/attestation"
    }
  }
}
