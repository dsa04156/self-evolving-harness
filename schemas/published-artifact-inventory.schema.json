{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://self-evolving-harness.local/schemas/published-artifact-inventory.schema.json",
  "title": "Content-addressed inventory of a published Git snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "inventoryId",
    "recordType",
    "repository",
    "snapshotCommit",
    "snapshotTree",
    "entries",
    "entryCount",
    "createdAt",
    "inventoryHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "inventoryId": {
      "$ref": "./common.schema.json#/$defs/entityId"
    },
    "recordType": {
      "const": "published_artifact_inventory"
    },
    "repository": {
      "$ref": "#/$defs/repository"
    },
    "snapshotCommit": {
      "$ref": "#/$defs/gitObjectId"
    },
    "snapshotTree": {
      "$ref": "#/$defs/gitObjectId"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "mode",
          "objectType",
          "objectId",
          "sizeBytes",
          "contentSha256"
        ],
        "properties": {
          "path": {
            "$ref": "#/$defs/path"
          },
          "mode": {
            "type": "string",
            "pattern": "^(100644|100755|120000)$"
          },
          "objectType": {
            "const": "blob"
          },
          "objectId": {
            "$ref": "#/$defs/gitObjectId"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1073741824
          },
          "contentSha256": {
            "$ref": "./common.schema.json#/$defs/sha256"
          }
        }
      }
    },
    "entryCount": {
      "type": "integer",
      "minimum": 1
    },
    "createdAt": {
      "$ref": "./common.schema.json#/$defs/timestamp"
    },
    "inventoryHash": {
      "$ref": "./common.schema.json#/$defs/sha256"
    }
  },
  "$defs": {
    "gitObjectId": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "owner",
        "remoteName",
        "branch"
      ],
      "properties": {
        "url": {
          "type": "string",
          "const": "https://github.com/dsa04156/self-evolving-harness"
        },
        "owner": {
          "const": "dsa04156"
        },
        "remoteName": {
          "const": "origin"
        },
        "branch": {
          "const": "main"
        }
      }
    }
  }
}
