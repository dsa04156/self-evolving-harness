{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://self-evolving-harness.local/schemas/deployment-decision.schema.json",
  "title": "DeploymentDecision",
  "description": "Promoter-authenticated authorization for one production-channel CAS. expectedBefore commits the complete prior target/rollback tuple; the decision commits the complete post-state tuple.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "deploymentDecisionId",
    "protocolId",
    "epistemicClass",
    "action",
    "channelId",
    "expectedBefore",
    "target",
    "targetQualificationDecisionId",
    "rollbackTargetHarnessVersionId",
    "rollbackTargetManifestHash",
    "rollbackTargetQualificationDecisionId",
    "deploymentPolicyHash",
    "reasonCodes",
    "decidedBy",
    "decidedAt",
    "auditLink",
    "attestation"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "deploymentDecisionId": {
      "$ref": "./common.schema.json#/$defs/entityId"
    },
    "protocolId": {
      "$ref": "./common.schema.json#/$defs/protocolId"
    },
    "epistemicClass": {
      "const": "control_decision"
    },
    "action": {
      "type": "string",
      "enum": [
        "initialize",
        "deploy",
        "rollback",
        "decommission"
      ]
    },
    "channelId": {
      "const": "production"
    },
    "expectedBefore": {
      "$ref": "#/$defs/pointerExpectation"
    },
    "target": {
      "$ref": "#/$defs/pointerTarget"
    },
    "targetQualificationDecisionId": {
      "$ref": "#/$defs/nullableEntityId"
    },
    "rollbackTargetHarnessVersionId": {
      "$ref": "#/$defs/nullableHarnessVersionId"
    },
    "rollbackTargetManifestHash": {
      "$ref": "#/$defs/nullableSha256"
    },
    "rollbackTargetQualificationDecisionId": {
      "$ref": "#/$defs/nullableEntityId"
    },
    "deploymentPolicyHash": {
      "$ref": "./common.schema.json#/$defs/sha256"
    },
    "reasonCodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{2,95}$"
      }
    },
    "decidedBy": {
      "$ref": "./common.schema.json#/$defs/principalIdentity"
    },
    "decidedAt": {
      "$ref": "./common.schema.json#/$defs/timestamp"
    },
    "auditLink": {
      "$ref": "./common.schema.json#/$defs/auditLink"
    },
    "attestation": {
      "$ref": "./common.schema.json#/$defs/attestation"
    }
  },
  "$defs": {
    "nullableHarnessVersionId": {
      "oneOf": [
        {
          "$ref": "./common.schema.json#/$defs/harnessVersionId"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableSha256": {
      "oneOf": [
        {
          "$ref": "./common.schema.json#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableEntityId": {
      "oneOf": [
        {
          "$ref": "./common.schema.json#/$defs/entityId"
        },
        {
          "type": "null"
        }
      ]
    },
    "pointerExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation",
        "harnessVersionId",
        "manifestHash",
        "targetQualificationDecisionId",
        "rollbackTargetHarnessVersionId",
        "rollbackTargetManifestHash",
        "rollbackTargetQualificationDecisionId",
        "pointerRecordHash"
      ],
      "properties": {
        "generation": {
          "type": "integer",
          "minimum": -1
        },
        "harnessVersionId": {
          "$ref": "#/$defs/nullableHarnessVersionId"
        },
        "manifestHash": {
          "$ref": "#/$defs/nullableSha256"
        },
        "targetQualificationDecisionId": {
          "$ref": "#/$defs/nullableEntityId"
        },
        "rollbackTargetHarnessVersionId": {
          "$ref": "#/$defs/nullableHarnessVersionId"
        },
        "rollbackTargetManifestHash": {
          "$ref": "#/$defs/nullableSha256"
        },
        "rollbackTargetQualificationDecisionId": {
          "$ref": "#/$defs/nullableEntityId"
        },
        "pointerRecordHash": {
          "$ref": "#/$defs/nullableSha256"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "rollbackTargetHarnessVersionId": {
                "type": "null"
              }
            },
            "required": [
              "rollbackTargetHarnessVersionId"
            ]
          },
          "then": {
            "properties": {
              "rollbackTargetManifestHash": {
                "type": "null"
              },
              "rollbackTargetQualificationDecisionId": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "rollbackTargetManifestHash": {
                "$ref": "./common.schema.json#/$defs/sha256"
              },
              "rollbackTargetQualificationDecisionId": {
                "$ref": "./common.schema.json#/$defs/entityId"
              }
            }
          }
        }
      ]
    },
    "pointerTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation",
        "harnessVersionId",
        "manifestHash"
      ],
      "properties": {
        "generation": {
          "type": "integer",
          "minimum": 0
        },
        "harnessVersionId": {
          "$ref": "#/$defs/nullableHarnessVersionId"
        },
        "manifestHash": {
          "$ref": "#/$defs/nullableSha256"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "harnessVersionId": {
                "type": "null"
              }
            },
            "required": [
              "harnessVersionId"
            ]
          },
          "then": {
            "properties": {
              "manifestHash": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "manifestHash": {
                "$ref": "./common.schema.json#/$defs/sha256"
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "decommission"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "target": {
            "properties": {
              "harnessVersionId": {
                "type": "null"
              },
              "manifestHash": {
                "type": "null"
              }
            }
          },
          "targetQualificationDecisionId": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "target": {
            "properties": {
              "harnessVersionId": {
                "$ref": "./common.schema.json#/$defs/harnessVersionId"
              },
              "manifestHash": {
                "$ref": "./common.schema.json#/$defs/sha256"
              }
            }
          },
          "targetQualificationDecisionId": {
            "$ref": "./common.schema.json#/$defs/entityId"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "enum": [
              "initialize",
              "decommission"
            ]
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "rollbackTargetHarnessVersionId": {
            "type": "null"
          },
          "rollbackTargetManifestHash": {
            "type": "null"
          },
          "rollbackTargetQualificationDecisionId": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "rollbackTargetHarnessVersionId": {
            "$ref": "./common.schema.json#/$defs/harnessVersionId"
          },
          "rollbackTargetManifestHash": {
            "$ref": "./common.schema.json#/$defs/sha256"
          },
          "rollbackTargetQualificationDecisionId": {
            "$ref": "./common.schema.json#/$defs/entityId"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "initialize"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "expectedBefore": {
            "properties": {
              "generation": {
                "const": -1
              },
              "harnessVersionId": {
                "type": "null"
              },
              "manifestHash": {
                "type": "null"
              },
              "targetQualificationDecisionId": {
                "type": "null"
              },
              "rollbackTargetHarnessVersionId": {
                "type": "null"
              },
              "rollbackTargetManifestHash": {
                "type": "null"
              },
              "rollbackTargetQualificationDecisionId": {
                "type": "null"
              },
              "pointerRecordHash": {
                "type": "null"
              }
            }
          },
          "target": {
            "properties": {
              "generation": {
                "const": 0
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "expectedBefore": {
            "properties": {
              "generation": {
                "minimum": 0
              },
              "harnessVersionId": {
                "$ref": "./common.schema.json#/$defs/harnessVersionId"
              },
              "manifestHash": {
                "$ref": "./common.schema.json#/$defs/sha256"
              },
              "targetQualificationDecisionId": {
                "$ref": "./common.schema.json#/$defs/entityId"
              },
              "pointerRecordHash": {
                "$ref": "./common.schema.json#/$defs/sha256"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "rollback"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "expectedBefore": {
            "properties": {
              "rollbackTargetHarnessVersionId": {
                "$ref": "./common.schema.json#/$defs/harnessVersionId"
              },
              "rollbackTargetManifestHash": {
                "$ref": "./common.schema.json#/$defs/sha256"
              },
              "rollbackTargetQualificationDecisionId": {
                "$ref": "./common.schema.json#/$defs/entityId"
              }
            }
          }
        }
      }
    }
  ]
}
